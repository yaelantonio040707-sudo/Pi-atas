# ─── Servidor ─────────────────────────────────────────────
NODE_ENV=production
PORT=3000
# URL pública definitiva, sin "/" al final. Se usa para SEO, sitemap y el código QR.
# Ejemplo: SITE_URL=https://keflita.com
SITE_URL=
# Carpeta para la base de datos y las fotos subidas (debe ser un disco persistente en producción).
DATA_DIR=data
# Ponlo en 1 si el sitio está detrás de un proxy (Render, Railway, Nginx, Cloudflare…).
TRUST_PROXY=1

# ─── Panel de administración (/admin) ─────────────────────
ADMIN_USERNAME=admin
# Genera este valor con:  npm run admin:hash
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_HOURS=12

# ─── Asistente con IA (opcional) ──────────────────────────
# Sin clave, el asistente responde con las preguntas frecuentes del panel.
# Obtén una clave en https://platform.claude.com  (NUNCA la subas a GitHub).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high  (low = respuestas rápidas y económicas)
ANTHROPIC_EFFORT=low

# ─── Contacto ─────────────────────────────────────────────
# Número de WhatsApp inicial con código de país, solo dígitos (ej. 52 + 10 dígitos).
# También se puede configurar después desde el panel.
WHATSAPP_NUMBER=

# Tamaño máximo por imagen subida (MB)
MAX_UPLOAD_MB=8
